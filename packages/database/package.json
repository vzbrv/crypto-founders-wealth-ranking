{
  "name": "@crypto-founders/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "sync:curated-data": "tsx src/sync-curated-data.ts",
    "test:migrations": "vitest run src/database.test.ts",
    "verify:production": "tsx src/verify-production.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@crypto-founders/curated-data": "workspace:*",
    "@crypto-founders/schemas": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4"
  }
}
