{
  "name": "crypto-founders-wealth-ranking",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "pnpm validate:data",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "e2e": "pnpm test:e2e",
    "test:e2e": "pnpm --filter @crypto-founders/web test:e2e",
    "sync:curated-data": "pnpm --filter @crypto-founders/database sync:curated-data",
    "validate:data": "pnpm --filter @crypto-founders/curated-data validate",
    "validate:production-data": "pnpm --filter @crypto-founders/curated-data validate:production",
    "smoke:production": "node scripts/smoke-production.mjs",
    "validate:database": "pnpm --filter @crypto-founders/database test:migrations",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm validate:database && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@types/node": "25.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
