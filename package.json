{
  "name": "crypto-founders-wealth-ranking",
  "version": "1.0.0",
  "description": "Source-backed index of value created by crypto founders and founding teams.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/vzbrv/crypto-founders-wealth-ranking#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vzbrv/crypto-founders-wealth-ranking.git"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prebuild": "pnpm validate:production-data",
    "build": "turbo run build",
    "prebuild:web:production": "node scripts/validate-public-web-env.mjs",
    "build:web:production": "pnpm --filter @crypto-founders/web build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "e2e": "pnpm test:e2e",
    "test:e2e": "pnpm --filter @crypto-founders/web test:e2e",
    "e2e:install": "pnpm --filter @crypto-founders/web exec playwright install chromium",
    "sync:curated-data": "pnpm --filter @crypto-founders/database sync:curated-data",
    "validate:data": "pnpm --filter @crypto-founders/curated-data validate",
    "validate:production-data": "CURATED_DATA_DIR=data/production pnpm --filter @crypto-founders/curated-data validate:production",
    "validate:research-data": "pnpm --filter @crypto-founders/curated-data validate:research",
    "reproduce:snapshot": "tsx scripts/reproduce-snapshot.ts",
    "validate:unified-data": "pnpm --filter @crypto-founders/curated-data validate:unified",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify:production-database": "pnpm --filter @crypto-founders/database verify:production",
    "validate:database": "pnpm --filter @crypto-founders/database test:migrations",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm validate:database && pnpm validate:unified-data && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
